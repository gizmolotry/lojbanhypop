__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secret/config material
.env
config/
!config/*.example
!config/README.md
archive/lineage/local_cache/
archive/lineage/**/__pycache__/
archive/lineage/**/.pytest_cache/
archive/cleanup_snapshots/

# Experiment and model artifacts
artifacts/
runs/
!runs/README.md
src/runs/
*.safetensors
*.pt
*.bin
*.ckpt
*.gguf

# Local scratch dirs created by pytest on this machine
cachepytest/
pytest-cache-files-*/
src/pytest-cache-files-*/
src/.pytest_tmp/
src/.tmp_pytest/
src/pytest-cache-files-*/
archive/**/cachepytest/
archive/**/pytest-cache-files-*/
archive/**/.pytest_tmp/
archive/**/.tmp_pytest/

# Prevent top-level output clutter from reappearing
RESULTS_*/
ROOT_*/
REPORTS_RELEVANT/

# Test-generated baseline hashes; tracked golden baselines remain tracked.
docs/baselines/test_m_series_baseline_*.json
