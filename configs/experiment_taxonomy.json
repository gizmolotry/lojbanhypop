      "architectural_thesis": "improve predicate and operator grounding before later chain-style reasoning expansions.",
      "allowed_ablation_axes": [
        "semantic probe family",
        "predicate grounding",
        "operator family evaluation"
      ],
      "forbidden_drift_axes": [
        "scratchpad token injection",
        "M11 discriminative readout substitution"
