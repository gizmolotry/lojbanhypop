    "M14": {
      "question_boundary": "symbiote scratchpad re-entry",
      "architectural_thesis": "use bounded scratchpad tokens as a compute horizon while injecting continuous advisor math only into scratchpad states before English resumption.",
      "allowed_ablation_axes": [
        "scratchpad length",
        "scratchpad gate threshold",
        "injection layer",
        "residual scratchpad alpha"
      ],
      "forbidden_drift_axes": [
        "direct raw sidecar exposure to answer token",
        "token-only return path as mainline"
      ],
      "promotion_basis": [
        "mean_intervention_delta_gold",
        "resume_first_token_accuracy",
        "scratchpad_bleed_rate"
      ],
      "metrics_primary": [
        "mean_intervention_delta_gold",
        "resume_first_token_accuracy"
      ],
