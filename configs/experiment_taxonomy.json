  "major_families": {
    "M1": {
      "question_boundary": "data invariance and adversarial synthesis diagnostics",
      "architectural_thesis": "lock dataset invariance, paraphrase robustness, and foil acceptance before architectural coupling work.",
      "allowed_ablation_axes": [
        "generator depth",
        "foil acceptance thresholds",
        "invariance synthesis",
        "scope diagnostics"
      ],
      "forbidden_drift_axes": [
        "bridge architecture changes",
        "decoder residual injection",
        "scratchpad token mediation"
      ],
      "promotion_basis": [
        "accept_rate_by_depth",
        "accepted_foil_pair_accuracy",
        "invariance rate"
      ],
      "metrics_primary": [
        "accepted_foil_pair_accuracy",
        "invariance rate"
      ],
      "metrics_guardrail": [
        "accept_rate_by_depth"
      ],
      "baseline_manifest": "docs/baselines/m1_series_baseline_manifest.json"
    },
    "M2": {
      "question_boundary": "constraint-optimized Lagrangian training",
      "architectural_thesis": "replace static objective blending with lexicographic augmented-Lagrangian control while preserving scoped identity and arity constraints.",
      "allowed_ablation_axes": [
        "tier-a lock regime",
        "scope drill pressure",
        "tier-b force valves",
        "soft identity audit"
      ],
      "forbidden_drift_axes": [
        "bridge exposure strategy",
        "scratchpad tokenizer changes",
        "decoder continuation losses"
      ],
      "promotion_basis": [
        "constraint_arity_strict",
        "constraint_scope",
        "constraint_identity"
      ],
      "metrics_primary": [
        "constraint_scope",
        "constraint_identity"
      ],
      "metrics_guardrail": [
        "constraint_arity_strict"
      ],
      "baseline_manifest": "docs/baselines/m2_series_baseline_manifest.json"
    },
    "M3": {
      "question_boundary": "bridge exposure and return-channel shaping",
      "architectural_thesis": "test how structured advisor state should couple back into generation without collapsing the decoder's English continuation manifold.",
      "allowed_ablation_axes": [
        "LoRA positioning",
        "bias or return-state geometry",
        "answer path forcing",
        "residual re-entry compression",
        "continuation supervision"
      ],
      "forbidden_drift_axes": [
        "base dataset family replacement",
        "discriminator-only evaluation as sole success criterion"
      ],
      "promotion_basis": [
        "mean_intervention_delta_gold",
        "resume_first_token_accuracy",
        "english_fluency_score"
      ],
      "metrics_primary": [
        "overall_accuracy",
