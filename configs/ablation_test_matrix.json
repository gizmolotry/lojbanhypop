{
  "schema_version": "2026-05-31",
  "purpose": "Series-aware pytest matrix for validating ablation families through the same ledger-style control plane used by the experiment runners.",
  "default_lane": "smoke",
  "coverage_policy": {
    "all_pytest_files_listed": true,
    "discover_glob": "tests/test_*.py"
  },
  "output_root": "artifacts/runs/telemetry/raw/ablation/hypercube/ablation_test_matrix",
  "lanes": {
    "smoke": {
      "description": "Fast confidence tests for the active control plane and current family surfaces."
    },
    "ledger": {
      "description": "Control-plane, registry, taxonomy, direct-eval, and whole-grid contract tests."
    },
    "architecture": {
      "description": "Model/component unit tests for current and historical research families."
    },
    "full": {
      "description": "Every tracked pytest file in the repository."
    }
  },
